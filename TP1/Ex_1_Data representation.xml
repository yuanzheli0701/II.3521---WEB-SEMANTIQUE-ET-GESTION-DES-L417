<?xml version="1.0" encoding="UTF-8"?>

<courses>

    <course code="DSA201" credits="4">

        <title>Data Structures and Algorithms</title>

        <description>
            This course introduces the basic concepts of data structures
            and algorithms, including arrays, lists, stacks, queues and sorting.
        </description>

        <professor>Mr. Martin</professor>

        <topic>Data Structures</topic>
        <topic>Algorithms</topic>
        <topic>Sorting</topic>

    </course>


    <course code="DB202" credits="3">

        <title>Database Management</title>

        <description>
            This course covers relational databases, SQL, database design
            and basic database management concepts.
        </description>

        <professor>Prof. Bernard</professor>

        <topic>SQL</topic>
        <topic>Relational Databases</topic>
        <topic>Database Design</topic>

        <prerequisites>
            <course>DSA201</course>
        </prerequisites>

        <textbook isbn="978-0133970777">
            <title>Database System Concepts</title>
            <author>Abraham Silberschatz</author>
        </textbook>

    </course>


    <course code="ML301" credits="5">

        <title>Machine Learning</title>

        <description>
            This course introduces machine learning concepts, including
            supervised learning, unsupervised learning and model evaluation.
        </description>

        <professor>Dr. Thomas</professor>

        <topic>Supervised Learning</topic>
        <topic>Unsupervised Learning</topic>
        <topic>Model Evaluation</topic>

        <prerequisites>
            <course>DSA201</course>
        </prerequisites>

        <textbook isbn="978-0262046305">
            <title>Artificial Intelligence: A Modern Approach</title>
            <author>Stuart Russell</author>
        </textbook>

    </course>


    <course code="BD302" credits="4">

        <title>Big Data Technologies</title>

        <description>
            This course focuses on big data processing, distributed systems,
            data pipelines and technologies such as Hadoop and Spark.
        </description>

        <professor>Prof. Dupont</professor>

        <topic>Big Data</topic>
        <topic>Hadoop</topic>
        <topic>Apache Spark</topic>
        <topic>Data Pipelines</topic>

        <prerequisites>
            <course>DB202</course>
            <course>DSA201</course>
        </prerequisites>

        <textbook isbn="978-1491901632">
            <title>Hadoop: The Definitive Guide</title>
            <author>Tom White</author>
        </textbook>

    </course>

</courses>