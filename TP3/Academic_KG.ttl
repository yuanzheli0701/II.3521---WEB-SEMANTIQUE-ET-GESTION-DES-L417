@prefix ex:   <http://example.org/academic/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:Professor a rdfs:Class ;
    rdfs:label "Professor" .

ex:Course a rdfs:Class ;
    rdfs:label "Course" .

ex:Skill a rdfs:Class ;
    rdfs:label "Skill" .

ex:Program a rdfs:Class ;
    rdfs:label "Program" .

ex:CareerPath a rdfs:Class ;
    rdfs:label "Career path" .

ex:teaches a rdf:Property ;
    rdfs:label "teaches" ;
    rdfs:domain ex:Professor ;
    rdfs:range ex:Course ;
    owl:inverseOf ex:isTaughtBy .

ex:isTaughtBy a rdf:Property ;
    rdfs:label "is taught by" ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Professor .

ex:developsSkill a rdf:Property ;
    rdfs:label "develops skill" ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Skill .

ex:hasPrerequisite a rdf:Property ;
    rdfs:label "has prerequisite" ;
    rdfs:domain ex:Course .

ex:requiresSkill a rdf:Property ;
    rdfs:label "requires skill" ;
    rdfs:domain ex:CareerPath ;
    rdfs:range ex:Skill .

ex:isPartOf a rdf:Property ;
    rdfs:label "is part of" ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Program .

ex:hasTitle a rdf:Property ;
    rdfs:label "has title" ;
    rdfs:domain ex:Course ;
    rdfs:range xsd:string .

ex:hasCreditValue a rdf:Property ;
    rdfs:label "has credit value" ;
    rdfs:domain ex:Course ;
    rdfs:range xsd:integer .

ex:name a rdf:Property ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

ex:P01 a ex:Professor ;
    ex:name "Anna Mueller" ;
    ex:teaches ex:CS301 .

ex:P02 a ex:Professor ;
    ex:name "Wei Zhang" ;
    ex:teaches ex:CS401 .

ex:P03 a ex:Professor ;
    ex:name "David Martin" ;
    ex:teaches ex:CS305 .

ex:CS301 a ex:Course ;
    ex:hasTitle "Introduction to Machine Learning" ;
    ex:hasCreditValue 4 ;
    ex:isTaughtBy ex:P01 ;
    ex:developsSkill ex:S01, ex:S02, ex:S03 ;
    ex:hasPrerequisite ex:S02 ;
    ex:isPartOf ex:MasterDataScience .

ex:CS401 a ex:Course ;
    ex:hasTitle "Advanced Machine Learning" ;
    ex:hasCreditValue 4 ;
    ex:isTaughtBy ex:P02 ;
    ex:developsSkill ex:S01, ex:S04 ;
    ex:hasPrerequisite ex:CS301 .

ex:CS305 a ex:Course ;
    ex:hasTitle "Data Management" ;
    ex:hasCreditValue 3 ;
    ex:isTaughtBy ex:P03 ;
    ex:developsSkill ex:S02 .

ex:S01 a ex:Skill ;
    ex:name "Machine Learning" .

ex:S02 a ex:Skill ;
    ex:name "Python Programming" .

ex:S03 a ex:Skill ;
    ex:name "Statistics" .

ex:S04 a ex:Skill ;
    ex:name "Deep Learning" .

ex:MasterDataScience a ex:Program ;
    ex:name "Master of Data Science" .

ex:DataScientist a ex:CareerPath ;
    ex:name "Data Scientist" ;
    ex:requiresSkill ex:S01, ex:S02, ex:S03 .
