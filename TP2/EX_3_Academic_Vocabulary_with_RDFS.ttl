@prefix s2a: <http://example.org/s2a/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

s2a:AcademicProgram
    a rdfs:Class .

s2a:UndergraduateProgram
    a rdfs:Class ;
    rdfs:subClassOf s2a:AcademicProgram .

s2a:BachelorOfScience
    a rdfs:Class ;
    rdfs:subClassOf s2a:UndergraduateProgram .

s2a:GraduateProgram
    a rdfs:Class ;
    rdfs:subClassOf s2a:AcademicProgram .

s2a:MasterOfScience
    a rdfs:Class ;
    rdfs:subClassOf s2a:GraduateProgram .

s2a:PhD
    a rdfs:Class ;
    rdfs:subClassOf s2a:GraduateProgram .
